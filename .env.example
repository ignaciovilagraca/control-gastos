# Copy to .env and fill in. .env is gitignored and must stay that way.

# --- Visa Home / Mis Tarjetas ---
CONTROL_GASTOS_DOCUMENT_NUMBER=""
CONTROL_GASTOS_VISA_PASSWORD=""
CONTROL_GASTOS_VISA_NICKNAME=""

# --- Telegram ---
# Two bots: one posts the spendings, the other reports errors.
CONTROL_GASTOS_TELEGRAM_GASTOS_TOKEN=""
CONTROL_GASTOS_TELEGRAM_ERRORES_TOKEN=""
# The conversation the spendings are posted to.
CONTROL_GASTOS_TELEGRAM_CHAT_ID=""

# --- Database ---
# All four are required. Nothing here has a default: where the database lives is
# a fact about one deployment, not about this program.
CONTROL_GASTOS_DB_URL=""
CONTROL_GASTOS_DB_USER=""
CONTROL_GASTOS_DB_PASSWORD=""
# Schema name, used by db-clean.sh only.
CONTROL_GASTOS_DB_NAME=""

# --- Optional ---
# Salary the running total is measured against, in dollars. Leave empty and the
# bot omits the "PORCENTAJE SUELDO" line and reports everything else.
CONTROL_GASTOS_MONTHLY_SALARY_USD=""

# Gmail OAuth, to read the one-time code the card portal mails at login.
CONTROL_GASTOS_GMAIL_CLIENT_ID=""
CONTROL_GASTOS_GMAIL_CLIENT_SECRET=""
CONTROL_GASTOS_GMAIL_REFRESH_TOKEN=""
CONTROL_GASTOS_GMAIL_QUERY=""
CONTROL_GASTOS_GMAIL_OTP_REGEX=""
